import {
  Box,
  CalloutBanner,
  LoadingSpinner,
} from "@holidays/designsystems-componentlibrary";
import { ComponentType, ReactNode, ReactElement, Suspense, lazy } from "react";

type Loader<T> = () => Promise<{ default: T }>;

type LazyLoadedComponent<P> = (props: P) => ReactElement<P, ComponentType<P>>;

/**
 * @param loader function that returns a promise that resolves a module with a default export of a React component
 * @param fallback ReactNode to be rendered while the component is being loaded, defaults to a loading fallback component
 *
 * @returns {LazyLoadedComponent} React component resolved by the loader promise. Fallback error message in case the loader promise is rejected
 */
function withClientImport<P>(
  loader: Loader<ComponentType<P>>,
  fallback: ReactNode = <LoadingFallbackComponent />,
): LazyLoadedComponent<P> {
  const ImportedComponent =
    typeof window === "undefined"
      ? EmptyComponent
      : lazy<ComponentType<P>>(() =>
          loader().catch(() => ({ default: DefaultErrorMessage })),
        );

  function WithRemoteImport(props: P) {
    return (
      <Suspense fallback={fallback}>
        {/* @ts-expect-error The imported component doesn't need to be rendered directly with intrinsic React attributes (e.g. key) */}
        <ImportedComponent {...props} />
      </Suspense>
    );
  }

  return WithRemoteImport;
}

function EmptyComponent() {
  return null;
}

const DefaultErrorMessage = () => {
  return (
    <Box justifyContent="center">
      <Box maxWidth="pageWidth" flexGrow={1} paddingY="md">
        <CalloutBanner
          title="Sorry, there is a problem with the service"
          description="Try again later."
          styleVariant="critical"
          emphasis="secondary"
        />
      </Box>
    </Box>
  );
};

const LoadingFallbackComponent = () => {
  return (
    <Box
      alignContent={"center"}
      width={"100%"}
      display={"flex"}
      justifyContent={"center"}
      padding={"md"}
    >
      <LoadingSpinner
        styleVariant="accentPrimary"
        aria-label="Loading content..."
      />
    </Box>
  );
};

export { withClientImport };
